generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id             String   @id @default(cuid())
  email          String?  @unique
  password       String?
  role           Role     @default(USER)
  name           String?
  cardUid        String?  @unique
  image          String?
  jobTitle       String?
  isActive       Boolean  @default(true)
  isInside       Boolean  @default(false)

  adminId        String?
  admin          User?    @relation("AdminToEmployee", fields: [adminId], references: [id])
  employees      User[]   @relation("AdminToEmployee")

  ownedDevices   Device[] @relation("AdminOwnedDevices")
  allowedDevices Device[] @relation("DeviceAccess")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  logs           Log[]

  validFrom      DateTime?
  validUntil     DateTime?

  @@index([adminId])
  @@index([role])
  @@index([cardUid])
  @@index([isActive])
}

model Device {
  id           String   @id @default(cuid())
  name         String
  macAddress   String   @unique
  deviceKey    String?  @default(cuid())
  description  String?
  isOnline     Boolean  @default(false)
  lastSeen     DateTime @default(now())

  relayTime   Int      @default(5)
  relayType   String   @default("NO")

  adminId      String
  admin        User     @relation("AdminOwnedDevices", fields: [adminId], references: [id], onDelete: Cascade)

  allowedUsers User[]   @relation("DeviceAccess")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  logs         Log[]

  @@index([adminId])
  @@index([macAddress])
  @@index([isOnline, lastSeen])
}

model Log {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  accessGranted Boolean

  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  userName      String?
  userRole      Role?
  cardUid       String

  deviceId      String?
  device        Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  direction     String?
  eventType     String?  @default("ACCESS")

  @@index([timestamp(sort: Desc)])
  @@index([deviceId, timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@index([eventType])
  @@index([accessGranted])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

enum Role {
  ADMIN
  USER
  GUEST
}

enum AccessStatus {
  GRANTED
  DENIED
}